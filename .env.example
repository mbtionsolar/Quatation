# Copy this file to ".env" (local) OR add the same values in Vercel / Render "Environment Variables".
# SECRET_KEY must be a long random value and must be the SAME on every server instance.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional (better for production): store a password HASH instead of the plain password.
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# ADMIN_PASSWORD_HASH=

# Optional: set to 1 on HTTPS. Vercel / Render turn this on automatically.
# COOKIE_SECURE=1

# Optional tuning (all have safe defaults)
# PDF_TIMEOUT=60        # seconds LibreOffice may take for one PDF
# PDF_LOCK_WAIT=30      # seconds a request waits if another PDF is being made
# PDF_WARMUP=1          # 1 = pre-start the PDF engine at boot, 0 = off
# LOG_LEVEL=INFO        # DEBUG / INFO / WARNING / ERROR
